		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition Ratios = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 1c5f5933d2ea4402b68f0c39bfd4480a

