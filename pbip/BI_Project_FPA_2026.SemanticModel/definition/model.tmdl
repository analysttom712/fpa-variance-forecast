ref table Query
ref table 'Question 1'
ref table 'Question 2'
ref table 'Question 4'
ref table Ratios
ref table FactFinance
ref table DimAccount
ref table DimPeriod
ref table DimOrganization
ref table DimDepartment

ref cultureInfo en-US

